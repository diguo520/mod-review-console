# 脚手架用 --dangerously-allow-all-builds 装依赖，批准列表不会落盘。
# pnpm 10+ 默认 verify-deps-before-run，裸 `pnpm build` 会再走 install 并报 ERR_PNPM_IGNORED_BUILDS。
# 自检应直接调 tsc/vite；这里关掉预检，避免模型仍敲 pnpm build 时卡死。
verify-deps-before-run=false

# Cloudflare Pages 这类 CI 会由平台自己跑 `pnpm install`, 构建命令改不动那一步。
# 少了这个开关, 下面这 5 个包的可选 install 脚本被忽略时 pnpm 会以
# ERR_PNPM_IGNORED_BUILDS 退出 1, 整个部署直接失败:
#   @parcel/watcher, @swc/core, core-js, less, protobufjs
# 它们只做原生加速/降级, 允许执行脚本不影响构建结果, 但必须让 install 退出码为 0。
dangerously-allow-all-builds=true
